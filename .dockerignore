# Never send credentials or local configuration to a Docker build context.
.env
.env.*
**/.env
**/.env.*
.envrc
**/.envrc
**/.direnv

# Repository and editor metadata
.git
.gitignore
.gcloudignore
.github
.DS_Store
.idea
.vscode

# Dependencies, caches, generated native projects, tests, and local data
**/node_modules
**/.expo
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.coverage
**/coverage
services/api/tests
apps/client/dist
apps/client/ios
apps/client/android
.local
.runtime
data
*.db
*.sqlite*
*.log

# Documentation and local tooling are not runtime image inputs.
docs
scripts
infra
INTELLIGENT_AUDIO_ANALYSIS_FINAL_DESIGN_AND_ARCHITECTURE.md

# Fixture mode needs one exact approved functional fixture, not a broad corpus.
fixtures/*
!fixtures/manifest.json
!fixtures/media
fixtures/media/*
!fixtures/media/intelligent-audio-analysis-fixture.wav
!fixtures/quality
fixtures/quality/*
!fixtures/quality/ask-questions.json
!fixtures/sidecars
fixtures/sidecars/*
!fixtures/sidecars/intelligent-audio-analysis-fixture.json
