# Pocket Demo configuration inventory
#
# This file contains placeholders and safe local-demo defaults only. Fixture mode
# requires no copy and no provider credentials. For a hosted deployment, copy it to
# an operator-owned private file and replace the values that docs/CONFIGURATION.md
# marks as consumed now. Future-adapter values remain an implementation checklist.
# Never expose a server value through EXPO_PUBLIC_ variables.
#
# Only the keys listed as "consumed now" in docs/CONFIGURATION.md affect this
# checkpoint. Provider, pricing, observability, rate-limit, and several hosted-runtime
# entries intentionally reserve the future contract; filling them does not implement
# or enable those integrations. Remote provider mode always fails closed.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
APP_ENV=development
DEMO_MODE=true
PROVIDER_MODE=fixture
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=8081
INLINE_WORKER=true
FIXTURE_ROOT=fixtures
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Public URLs, browser origins, and proxy behavior
# -----------------------------------------------------------------------------
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
TRUSTED_HOSTS=localhost,127.0.0.1,api
FORWARDED_ALLOW_IPS=127.0.0.1

# -----------------------------------------------------------------------------
# PostgreSQL / pgvector
# DATABASE_URL is for host-run processes. COMPOSE_DATABASE_URL is the equivalent
# service-network URL used by Compose. Percent-encode reserved password characters.
# -----------------------------------------------------------------------------
POSTGRES_USER=pocket
POSTGRES_PASSWORD=replace-me-local-postgres-password
POSTGRES_DB=pocket
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pocket:replace-me-local-postgres-password@localhost:5432/pocket
COMPOSE_DATABASE_URL=postgresql+psycopg://pocket:replace-me-local-postgres-password@postgres:5432/pocket
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_STATEMENT_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Blob/object storage
# The lightweight profile uses filesystem storage. Compose selects the implemented
# S3-compatible adapter and points it at the included private MinIO service.
# -----------------------------------------------------------------------------
BLOB_STORE_BACKEND=filesystem
BLOB_ROOT=.local/blobs
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pocket-demo
S3_KEY_PREFIX=pocket-demo
S3_ACCESS_KEY_ID=replace-me-local-minio-access-key
S3_SECRET_ACCESS_KEY=replace-me-local-minio-secret-key
S3_FORCE_PATH_STYLE=true
S3_USE_TLS=false
MINIO_ROOT_USER=replace-me-local-minio-access-key
MINIO_ROOT_PASSWORD=replace-me-local-minio-secret-key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MEDIA_GRANT_TTL_SECONDS=60
MULTIPART_PART_SIZE_MIB=16
ABANDONED_MULTIPART_TTL_HOURS=24
EPHEMERAL_DERIVATIVE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Demo authentication, cookies, and CSRF
# Generate independent high-entropy values before any shared or hosted deployment.
# Consumed now: SESSION_SECRET (signing fallback), TOKEN_SIGNING_SECRET,
# COOKIE_SECURE, and SESSION_TTL_SECONDS. The other entries reserve a future hosted
# cookie/CSRF policy and do not affect this checkpoint.
# -----------------------------------------------------------------------------
SESSION_SECRET=replace-me-with-at-least-32-random-bytes
CSRF_SECRET=replace-me-with-an-independent-32-byte-secret
TOKEN_SIGNING_SECRET=replace-me-with-an-independent-32-byte-capability-secret
SESSION_COOKIE_NAME=pocket_demo_session
CSRF_COOKIE_NAME=pocket_demo_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
DEMO_PRINCIPAL_A_EMAIL=alex@example.invalid
DEMO_PRINCIPAL_B_EMAIL=blair@example.invalid
DEMO_WORKSPACE_A_NAME=Pocket Demo Alpha
DEMO_WORKSPACE_B_NAME=Pocket Demo Beta

# -----------------------------------------------------------------------------
# Provider routing and data policy
# Keep remote calls disabled until credentials, model IDs, supported languages,
# retention/training terms, and the price catalog have all been smoke-tested.
# -----------------------------------------------------------------------------
ALLOW_REMOTE_PROVIDER_CALLS=false
PROVIDER_DATA_POLICY=synthetic-approved-only
PROVIDER_ALLOWED_LANGUAGES=en
PROVIDER_REQUIRE_NO_TRAINING=true
PROVIDER_REQUIRE_ZERO_RETENTION=true
PROVIDER_REGION=replace-me-approved-region
PROVIDER_CALLBACK_SECRET=replace-me-provider-callback-secret

ASSEMBLYAI_API_KEY=replace-me-assemblyai-api-key
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
SPEECH_STANDARD_ALIAS=speech.standard
SPEECH_STANDARD_MODEL=replace-me-with-pinned-assemblyai-model-id
SPEECH_STRONG_ALIAS=speech.strong
SPEECH_STRONG_MODEL=replace-me-with-pinned-assemblyai-model-id

OPENAI_API_KEY=replace-me-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_CHEAP_ALIAS=llm.cheap
LLM_CHEAP_MODEL=replace-me-with-pinned-openai-model-id
LLM_STRONG_ALIAS=llm.strong
LLM_STRONG_MODEL=replace-me-with-pinned-openai-model-id
EMBEDDING_ALIAS=embed.multilingual
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MAX_STRONG_CONTEXT_TOKENS=12000
MAX_CHEAP_REPAIR_ATTEMPTS=1
MAX_STRONG_REPAIR_ATTEMPTS=1

# -----------------------------------------------------------------------------
# Media processing and worker leases
# -----------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_BYTES=524288000
MAX_AUDIO_DURATION_SECONDS=7200
MAX_DURATION_MS=7200000
PROCESSING_SAMPLE_RATE_HZ=16000
PROCESSING_AUDIO_CHANNELS=1
PROCESSING_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=90
WORKER_HEARTBEAT_SECONDS=20
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
MEDIA_CHUNK_TARGET_SECONDS=600
MEDIA_CHUNK_OVERLAP_SECONDS=2
EVIDENCE_UNIT_MAX_TOKENS=700
ASK_POST_FUSION_CANDIDATES=8

# -----------------------------------------------------------------------------
# Budgets, quotas, rate limits, and retention
# Currency amounts are USD decimal strings. A cap override must be explicit.
# -----------------------------------------------------------------------------
MAX_AI_SPEND_PER_RECORDING_USD=2.00
MAX_AI_SPEND_PER_ASK_USD=0.10
MAX_AI_SPEND_PER_WORKSPACE_MONTH_USD=50.00
RECORDING_COST_CEILING_USD=2.00
ASK_COST_CEILING_USD=0.10
WORKSPACE_STORAGE_QUOTA_BYTES=5368709120
WORKSPACE_RECORDING_QUOTA=200
RECORDING_RETENTION_DAYS=30
ASK_MAX_CALLS_PER_SESSION=8
ASK_MAX_INPUT_TOKENS_PER_SESSION=32000
ASK_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=5
SWEEPER_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Versioned price catalog and cost reconciliation
# The checked-in catalog is deliberately disabled and contains no claimable rates.
# Replace it with a dated, reviewed catalog before enabling remote calls.
# -----------------------------------------------------------------------------
PRICE_CATALOG_PATH=infra/pricing/price-catalog.example.json
PRICE_CATALOG_VERSION=unconfigured-example-v1
PRICE_CATALOG_CURRENCY=USD
COST_RECONCILIATION_ENABLED=false
COST_RECONCILIATION_INTERVAL_SECONDS=900
PLATFORM_FIXED_COST_MONTHLY_USD=0.00

# -----------------------------------------------------------------------------
# Content-free observability
# -----------------------------------------------------------------------------
LOG_FORMAT=json
LOG_CONTENT_POLICY=metadata-only
REQUEST_ID_HEADER=X-Request-ID
OTEL_ENABLED=false
OTEL_SERVICE_NAME=pocket-demo-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=replace-me-if-required
METRICS_ENABLED=false
SENTRY_DSN=replace-me-server-sentry-dsn
SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Deterministic failure injection (tests/local demo only)
# -----------------------------------------------------------------------------
FAILURE_INJECTION_ENABLED=false
FAILURE_INJECTION_STAGE=none
FAILURE_INJECTION_MODE=none
FAILURE_INJECTION_COUNT=0
FAILURE_INJECTION_DELAY_MS=0
FAILURE_INJECTION_RECORDING_ID=

# -----------------------------------------------------------------------------
# Expo client-safe configuration. These values are compiled into web/native apps.
# Never add provider, database, object-store, session, or CSRF secrets here.
# For a physical device, use a LAN/TLS-reachable API URL instead of localhost.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_STATUS_POLL_INTERVAL_MS=1500
EXPO_PUBLIC_MEDIA_GRANT_REFRESH_SECONDS=45
EXPO_PUBLIC_SENTRY_DSN=

# Public native application identity/build metadata (not provider secrets).
EXPO_APP_NAME=Pocket Evidence Lab
EXPO_APP_SLUG=pocket-evidence-lab
EXPO_APP_SCHEME=pocketdemo
IOS_BUNDLE_IDENTIFIER=replace-me-com-company-pocketdemo
ANDROID_PACKAGE_NAME=replace-me-com-company-pocketdemo
EAS_PROJECT_ID=replace-me-eas-project-uuid
