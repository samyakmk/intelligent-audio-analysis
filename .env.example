# Intelligent Audio Analysis private secret template
#
# Copy only the secrets needed by the profile you run. All public behavior—models,
# provider URLs and policy, budgets, retries, timeouts, quotas, ports, origins, and
# client/native settings—lives in the checked-in config/intelligent-audio-analysis.json.
#
# Never prefix a secret with EXPO_PUBLIC_. Never commit the resulting .env file.

# When configured, npm start detects this key and enables Gemini automatically.
GEMINI_API_KEY=replace-me-gemini-api-key

# Recommended for any shared browser/API session. The local launcher has isolated
# development fallbacks, but explicit independent values are safer and reproducible.
SESSION_SECRET=replace-me-with-at-least-32-random-bytes
CSRF_SECRET=replace-me-with-an-independent-32-byte-secret
TOKEN_SIGNING_SECRET=replace-me-with-an-independent-32-byte-capability-secret

# Required only for the configured PostgreSQL/MinIO Compose profile. Database URLs
# contain credentials and therefore stay private. Percent-encode reserved password
# characters inside URLs.
POSTGRES_PASSWORD=replace-me-local-postgres-password
DATABASE_URL=postgresql+psycopg://audio_analysis:replace-me-local-postgres-password@localhost:5432/audio_analysis
COMPOSE_DATABASE_URL=postgresql+psycopg://audio_analysis:replace-me-local-postgres-password@postgres:5432/audio_analysis
S3_ACCESS_KEY_ID=replace-me-object-store-access-key
S3_SECRET_ACCESS_KEY=replace-me-object-store-secret-key
MINIO_ROOT_USER=replace-me-local-minio-access-key
MINIO_ROOT_PASSWORD=replace-me-local-minio-secret-key

# Reserved future provider/integration secrets. Leave blank until their checked-in
# adapter or integration is implemented and deliberately enabled.
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
PROVIDER_CALLBACK_SECRET=
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=
